# ─────────────────────────────────────────────────────────────────────────────
#  Symphony × Thumbtack OFFLINE demo — single source of truth
# ─────────────────────────────────────────────────────────────────────────────
#
# Copy this file to `config.env`. There is nothing you HAVE to fill in —
# everything below has a sensible default. This file exists so you can
# override any path or flag if you move the demo around.
#
# This is the offline / backup variant: no Linear, no GitHub. The only
# external dependencies the demo uses are Python, git, and Claude Code.
#
# config.env is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# 1. Path to the promatch repo Symphony will dispatch agents into.
#    This MUST be a real local git repo. Agents push branches here LOCALLY —
#    there is no `origin` remote.
#    Default: the bundled `promatch/` next to this file.
TARGET_REPO=$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/promatch

# 2. Path to the local task store (the file that replaces Linear).
#    The orchestrator reads this on every poll; the agent's `tasks` CLI
#    writes to it through an advisory file lock.
SYMPHONY_TASKS_FILE=$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/tasks.json

# ─────────────────────────────────────────────────────────────────────────────
# Below are derived / advanced values. Most users don't need to touch these.
# ─────────────────────────────────────────────────────────────────────────────

# Where this whole demo lives. Auto-detected; override only if you move things.
SYMPHONY_DIR=$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)

# Symphony's debug verbosity. `info` is fine for demos; `debug` for debugging.
SYMPHONY_LOG_LEVEL=info

# Export them so child processes (Symphony, hooks, scripts, the agent) inherit.
export TARGET_REPO SYMPHONY_TASKS_FILE SYMPHONY_DIR SYMPHONY_LOG_LEVEL
